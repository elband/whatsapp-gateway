# ==========================================================
# WhatsApp Gateway Enterprise - Backend (PRODUKSI)
# Salin ke `.env` lalu sesuaikan kredensial DB/Redis & domain.
# Secret di bawah SUDAH di-generate acak — boleh dipakai, tapi
# disarankan generate ulang untuk tiap server.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"  # untuk SESSION_ENCRYPTION_KEY (64 hex)
# Lindungi file ini:  chmod 600 .env
# ==========================================================

# --- App ---
NODE_ENV=production
APP_NAME="WhatsApp Gateway"
PORT=4000
APP_URL=https://gateway.example.com
CORS_ORIGINS=https://gateway.example.com

# --- Database (MySQL / MariaDB) ---
# L5: pool tuning untuk produksi (sesuaikan dengan kapasitas DB).
DATABASE_URL="mysql://wagateway:GANTI_PASSWORD_DB@127.0.0.1:3306/whatsapp_gateway?connection_limit=10&pool_timeout=20"
# F4: read replica opsional (baca dialihkan ke sini; tulis tetap ke primary).
# Pisahkan beberapa replica dengan koma. Kosongkan bila single DB.
DATABASE_REPLICA_URL=

# --- Proxy & operasional ---
TRUST_PROXY=1
QUEUE_CONCURRENCY=5
# Proteksi Swagger di produksi (WAJIB diisi agar /api/docs aktif & aman)
DOCS_USER=admindocs
DOCS_PASS=GANTI_PASSWORD_DOCS

# --- Redis (Queue + Cache + Rate limit) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=GANTI_PASSWORD_REDIS
REDIS_DB=0

# --- JWT --- WAJIB generate sendiri, jangan pakai nilai contоh!
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=__GENERATE_ME_48_BYTES_HEX__
JWT_REFRESH_SECRET=__GENERATE_ME_DIFFERENT_48_BYTES_HEX__
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- Enkripsi session Baileys (32-byte hex / 64 chars) --- WAJIB generate sendiri!
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=__GENERATE_ME_32_BYTES_HEX__

# --- File upload ---
UPLOAD_DIR=../uploads
MAX_UPLOAD_MB=50

# --- Rate limit (global API) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Broadcast (anti-banned) ---
BROADCAST_MIN_DELAY_MS=3000
BROADCAST_MAX_DELAY_MS=8000
# Istirahat per-batch: tiap BATCH_SIZE pesan, jeda panjang acak (REST_MIN..MAX).
# Set BATCH_SIZE=0 untuk menonaktifkan.
BROADCAST_BATCH_SIZE=30
BROADCAST_BATCH_REST_MIN_MS=180000
BROADCAST_BATCH_REST_MAX_MS=600000

# --- Logging ---
LOG_LEVEL=info
LOG_DIR=../logs

# --- Admin default (saat seed; SEGERA ganti password setelah login) ---
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_EMAIL=admin@gateway.example.com
SEED_ADMIN_PASSWORD=GANTI_PASSWORD_ADMIN_KUAT
