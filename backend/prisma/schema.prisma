// WhatsApp Gateway Enterprise - Prisma Schema
// Database: MySQL / MariaDB

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & RBAC
// ============================================================

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  password     String
  phone        String?
  avatar       String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  roleId       Int
  role         Role      @relation(fields: [roleId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens RefreshToken[]
  apiKeys       ApiKey[]
  devices       Device[]
  auditLogs     Log[]

  @@index([roleId])
  @@map("users")
}

model Role {
  id          Int       @id @default(autoincrement())
  name        String    @unique // admin, operator, viewer, ...
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int       @id @default(autoincrement())
  name        String    @unique // e.g. "device.create", "message.send"
  group       String              // e.g. "device", "message"
  description String?
  createdAt   DateTime  @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @db.VarChar(255) // SHA-256 dari refresh token
  userAgent String?
  ip        String?
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model ApiKey {
  id          Int       @id @default(autoincrement())
  name        String                  // nama aplikasi konsumen (ERP, Helpdesk, dll)
  keyPrefix   String    @unique       // bagian publik untuk identifikasi cepat
  keyHash     String    @db.VarChar(255) // SHA-256 dari API key penuh
  scopes      Json?                   // daftar permission/scope opsional
  defaultDeviceId Int?                // device default untuk app ini
  rateLimit   Int       @default(0)   // 0 = pakai default global
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdById Int?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([keyPrefix])
  @@map("api_keys")
}

// ============================================================
// WHATSAPP DEVICES & SESSIONS
// ============================================================

enum DeviceStatus {
  INITIALIZING
  QR
  CONNECTING
  CONNECTED
  DISCONNECTED
  LOGGED_OUT
}

model DeviceGroup {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())

  devices Device[]

  @@map("device_groups")
}

model Device {
  id           Int          @id @default(autoincrement())
  name         String
  deviceId     String       @unique // id internal Baileys (uuid)
  phoneNumber  String?      // nomor terhubung (jid user)
  status       DeviceStatus @default(INITIALIZING)
  qr           String?      @db.Text // data URL QR terkini
  groupId      Int?
  group        DeviceGroup? @relation(fields: [groupId], references: [id])
  ownerId      Int?
  owner        User?        @relation(fields: [ownerId], references: [id])
  webhookUrl   String?
  webhookEvents Json?       // event yang di-subscribe
  lastSeenAt   DateTime?
  connectedAt  DateTime?
  autoReconnect Boolean     @default(true)
  quota        Int          @default(0) // 0 = unlimited (kuota pesan keluar)
  quotaUsed    Int          @default(0)
  shardId      Int?         // F3: WA-worker shard pemilik device (sticky assignment)
  meta         Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  sessions     Session[]
  messages     Message[]
  broadcasts   Broadcast[]
  autoresponders Autoresponder[]

  @@index([groupId])
  @@index([status])
  @@index([shardId])
  @@map("devices")
}

// Penyimpanan auth-state Baileys (terenkripsi) di database.
// Satu device punya banyak baris key (creds + signal keys).
model Session {
  id        Int      @id @default(autoincrement())
  deviceId  Int
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  keyId     String   // contoh: "creds", "app-state-sync-key-xxx", "session-628xxx"
  value     String   @db.LongText // payload terenkripsi (AES-256-GCM, base64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([deviceId, keyId])
  @@index([deviceId])
  @@map("sessions")
}

// ============================================================
// CONTACTS
// ============================================================

model ContactGroup {
  id        Int      @id @default(autoincrement())
  name      String
  color     String?
  createdAt DateTime @default(now())

  contacts ContactGroupMember[]

  @@map("contact_groups")
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String?
  tags      Json?    // array of string
  meta      Json?    // field dinamis untuk variabel template
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groups ContactGroupMember[]

  @@unique([phone])
  @@index([name])
  @@map("contacts")
}

model ContactGroupMember {
  contactId Int
  groupId   Int
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([contactId, groupId])
  @@map("contact_group_members")
}

// ============================================================
// MESSAGES & ATTACHMENTS
// ============================================================

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  LOCATION
  CONTACT
  BUTTON
  LIST
}

enum MessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id          Int              @id @default(autoincrement())
  deviceId    Int
  device      Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  direction   MessageDirection
  type        MessageType      @default(TEXT)
  status      MessageStatus    @default(QUEUED)
  to          String?          // jid/nomor tujuan (outbound)
  from        String?          // jid/nomor pengirim (inbound)
  body        String?          @db.Text
  caption     String?          @db.Text
  waMessageId String?          // id pesan dari WhatsApp
  error       String?          @db.Text
  broadcastItemId Int?         @unique
  apiKeyId    Int?
  meta        Json?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  seenAt      DateTime?        // inbound: ditandai sudah dibaca di inbox dashboard
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  attachments Attachment[]
  broadcastItem BroadcastItem? @relation(fields: [broadcastItemId], references: [id])

  @@index([deviceId])
  @@index([status])
  @@index([direction])
  @@index([waMessageId])
  @@index([createdAt])
  @@index([deviceId, from])
  @@index([deviceId, to])
  @@map("messages")
}

model Attachment {
  id        Int      @id @default(autoincrement())
  messageId Int
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName  String
  filePath  String
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())

  @@index([messageId])
  @@map("attachments")
}

// ============================================================
// BROADCAST
// ============================================================

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

model Broadcast {
  id          Int             @id @default(autoincrement())
  name        String
  deviceId    Int
  device      Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  templateId  Int?
  template    Template?       @relation(fields: [templateId], references: [id])
  status      BroadcastStatus @default(DRAFT)
  messageType MessageType     @default(TEXT)
  body        String?         @db.Text
  mediaPath   String?
  caption     String?         @db.Text
  minDelayMs  Int             @default(3000)
  maxDelayMs  Int             @default(8000)
  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  total       Int             @default(0)
  sentCount   Int             @default(0)
  failedCount Int             @default(0)
  createdById Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  items BroadcastItem[]

  @@index([status])
  @@index([deviceId])
  @@map("broadcasts")
}

model BroadcastItem {
  id          Int           @id @default(autoincrement())
  broadcastId Int
  broadcast   Broadcast     @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contactId   Int?
  phone       String
  name        String?
  variables   Json?         // nilai variabel template per kontak
  status      MessageStatus @default(QUEUED)
  error       String?       @db.Text
  attempts    Int           @default(0)
  sentAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  message Message?

  @@index([broadcastId])
  @@index([status])
  @@map("broadcast_items")
}

// ============================================================
// TEMPLATES
// ============================================================

model Template {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  type        MessageType @default(TEXT)
  body        String      @db.Text // boleh memuat {{variabel}}
  caption     String?     @db.Text
  mediaPath   String?
  variables   Json?       // daftar nama variabel terdeteksi
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  broadcasts     Broadcast[]
  autoresponders Autoresponder[]

  @@map("templates")
}

// ============================================================
// AUTORESPONDER (auto-reply berbasis keyword)
// ============================================================

enum MatchType {
  EXACT
  CONTAINS
  STARTS_WITH
  REGEX
}

model Autoresponder {
  id         Int       @id @default(autoincrement())
  name       String
  deviceId   Int?      // null = berlaku untuk semua device
  device     Device?   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  keyword    String
  matchType  MatchType @default(CONTAINS)
  response   String    @db.Text
  templateId Int?
  template   Template? @relation(fields: [templateId], references: [id])
  isActive   Boolean   @default(true)
  priority   Int       @default(0) // makin besar makin diutamakan
  hitCount   Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([deviceId])
  @@map("autoresponders")
}

// ============================================================
// OTP
// ============================================================

model Otp {
  id         Int       @id @default(autoincrement())
  deviceId   Int?
  phone      String
  code       String
  purpose    String?
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone])
  @@map("otps")
}

// ============================================================
// LOGS / AUDIT
// ============================================================

enum LogType {
  API
  LOGIN
  ERROR
  BROADCAST
  DEVICE
  MESSAGE
  WEBHOOK
  CONTACT
  TEMPLATE
  SETTING
  SYSTEM
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

model Log {
  id        Int      @id @default(autoincrement())
  type      LogType
  level     LogLevel @default(INFO)
  action    String
  message   String?  @db.Text
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  apiKeyId  Int?
  deviceId  Int?
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([level])
  @@index([userId])
  @@index([createdAt])
  @@map("logs")
}

// ============================================================
// SETTINGS (key-value)
// ============================================================

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     Json
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@map("settings")
}
